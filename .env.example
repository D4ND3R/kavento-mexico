# ---------------------------------------------------------------
# Kavento — variables de entorno
# Copia este archivo como .env.local y llena los valores.
# .env.local NUNCA se sube al repositorio.
# ---------------------------------------------------------------

# Número de WhatsApp al que llegan las cotizaciones.
# Formato internacional, SOLO DÍGITOS, sin +, espacios ni guiones.
# México: 52 (país) + 1 (móvil) + 10 dígitos.  Ej: 5215512345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Correo de contacto mostrado en el pie de página.
NEXT_PUBLIC_CONTACT_EMAIL=hola@kavento.mx

# URL pública del sitio. Se usa para las metaetiquetas Open Graph,
# el sitemap y robots.txt. Sin diagonal final.
NEXT_PUBLIC_SITE_URL=https://kavento.mx

# Opcional: ID de analytics. Déjalo vacío para no cargar el script.
NEXT_PUBLIC_ANALYTICS_ID=
